{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-ollama-toolcall-proxy"
  ],
  "provider": {
    "kaggle-ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Kaggle Ollama (Cloudflare)",
      "options": {
        "baseURL": "https://deserve-workshops-sweet-possibilities.trycloudflare.com/v1",
        "apiKey": "ollama-kaggle",
        "chunkTimeout": 120000
      },
      "models": {
        "qwen2.5-coder-7b-instruct-q4": {
          "name": "qwen2.5-coder-7b-instruct-q4 (Kaggle)",
          "tools": true
        }
      }
    }
  },
  "permission": {
    "read": "allow",
    "edit": "allow",
    "bash": "allow",
    "grep": "allow",
    "glob": "allow",
    "webfetch": "allow",
    "external_directory": {
      "C:/Users/user/Desktop/dumper/**": "allow"
    }
  }
}