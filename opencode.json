{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-ollama-toolcall-proxy"
  ],
  "provider": {
    "kaggle-ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (Ngrok Fixo)",
      "options": {
        "baseURL": "https://display-author-stony.ngrok-free.dev/v1",
        "apiKey": "ollama-kaggle",
        "chunkTimeout": 300000,
        "timeout": false
      },
      "models": {
        "mimo-v2.6-9b-heretic": {
          "name": "mimo-v2.6-9b-heretic",
          "tools": true,
          "limit": {
            "context": 65536,
            "output": 4096
          }
        }
      }
    }
  },
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 4096
    }
  },
  "permission": {
    "read": "allow",
    "edit": "allow",
    "bash": "allow",
    "grep": "allow",
    "glob": "allow",
    "webfetch": "allow",
    "external_directory": {
      "*": "allow"
    }
  }
}